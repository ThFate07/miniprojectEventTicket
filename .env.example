# Central environment file for both frontend and backend.
# Copy this file to `.env` in the project root. Do not create separate frontend/backend env files.

# App URLs
PORT=8000
SERVER_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
VITE_API=http://localhost:8000/api

# Database and auth
MONGO_URI=mongodb://127.0.0.1:27017/book-my-event
JWT_SECRET=replace-with-a-long-random-secret
QR_SIGNING_SECRET=replace-with-a-long-random-secret

# Payments
RAZORPAY_KEY=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
VITE_RAZORPAY_KEY=rzp_test_replace_me

# Email
EMAIL=your-email@example.com
PASSWORD=your-email-app-password

# AI
GEMINI_API_KEY=replace_me

# Runtime
NODE_ENV=development
